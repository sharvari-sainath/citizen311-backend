PORT=4000

# Set to true to persist the mock Dataverse data to backend/data/db.json
# between server restarts. Leave false (default) to reset to seed data
# every time you restart, which is usually best for demos.
PERSIST=false

# --- Real Dataverse settings (not used yet - for when you complete Phase 1-4) ---
# DATAVERSE_URL=https://yourorg.crm.dynamics.com
# TENANT_ID=
# CLIENT_ID=
# CLIENT_SECRET=

# --- Real Foundry agent settings (not used yet - for when you complete Phase 8-9) ---
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_AGENT_ID=
